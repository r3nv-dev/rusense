# 99-rusense.rules — RuSense: grants write access to Linuwu-Sense
# driver controls for the "wheel" group.
#
# When the driver loads (platform device "acer-wmi" appears), applies
# chgrp/chmod to the control subdirectories that exist on this model:
#   - nitro_sense       (Nitro line)
#   - predator_sense    (Predator line — same attribute layout)
#   - platform-profile  (low-power/quiet/balanced/... profiles)
#
# Without this rule installed, rusense/rusense-gui runs in READ-ONLY mode —
# the app's "write permission denied" error points to install.sh.
#
# Install:    sudo ./install.sh  # (copies to /etc/udev/rules.d/ and reloads)
# Uninstall:  sudo rm /etc/udev/rules.d/99-rusense.rules && sudo udevadm control --reload
#
# Note: in udev rules, "$$" becomes a literal "$" in the executed command.   
#
ACTION=="add", SUBSYSTEM=="platform", KERNEL=="acer-wmi", \
  RUN+="/bin/sh -c 'for d in /sys$devpath/{nitro_sense,predator_sense,platform-profile}; \
    do [ -d $$d ] && { chgrp -R wheel $$d; \
      find $$d -type f -perm /u+w -exec chmod g+w {} +; }; done'"
